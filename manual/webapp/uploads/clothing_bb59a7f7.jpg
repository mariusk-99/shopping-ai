817e756-7721-4cfb-b404-04df79c685e4","81ca80b4-9be5-4dd5-a7de-06f9ae8861f7"],"taxonomyLabels":{"Brand":["Nike"],"Gender":["Men"],"Sports":["Workouts","Training \u0026 Gym"],"Collections":["Nike Form"],"Product Type":["Windbreakers"]},"pdpUrl":{"url":"https://www.nike.com/gb/t/form-dri-fit-hooded-versatile-jacket-J80P1W/FB7482-084","canonicalUrl":"https://www.nike.com/gb/t/form-dri-fit-hooded-versatile-jacket-J80P1W","path":"/gb/t/form-dri-fit-hooded-versatile-jacket-J80P1W/FB7482-084"},"prices":{"currency":"GBP","currentPrice":59.99,"initialPrice":59.99,"employeePrice":59.99,"discountPercentage":0,"employeeDiscountPercentage":0},"productInfo":{"badge":"Sustainable Materials","sizeFitSections":["\u003cul\u003e\n  \u003cli\u003eModel is wearing size M and is 5′11″ (180cm approx.)\u003c/li\u003e\n\u003c/ul\u003e","\u003cul\u003e\n  \u003cli\u003eStandard fit: easy and traditional\u003c/li\u003e\n\u003c/ul\u003e"],"title":"Nike Form","subtitle":"Men's Dri-FIT Hooded Versatile Jacket","fullTitle":"Nike Form Men's Dri-FIT Hooded Versatile Jacket","productDescription":"Built for running, training and yoga, this stretchy, sweat-wicking jacket is designed to help you stay fresh through your entire workout. Cut with a relaxed feel, this hooded full-zip keeps your essentials close with pocket storage on the way to and from the gym.","moreDescriptions":[],"featuresAndBenefits":[{"header":"Benefits","body":["A hood provides protection from the elements.","Front pockets give easy-to-reach storage.","Nike Dri-FIT helps move sweat away from the skin.","The full-zip design makes for easy changing.","The lightweight woven fabric has plenty of stretch to help you through every move."]}],"enhancedBenefits":[],"productDetails":[{"header":"Product Details","body":["Elastic cuffs and hood opening","Reflective design Swoosh logo","100% polyester","Machine wash","Imported","Not intended for use as Personal Protective Equipment (PPE)"]}],"origins":[],"url":"https://www.nike.com/gb/t/form-dri-fit-hooded-versatile-jacket-J80P1W/FB7482-084","canonicalUrl":"https://www.nike.com/gb/t/form-dri-fit-hooded-versatile-jacket-J80P1W","path":"/gb/t/form-dri-fit-hooded-versatile-jacket-J80P1W/FB7482-084","sustainabilityMessage":[{"jsonBody":{"type":"doc","content":[{"content":[{"content":[{"text":"The recycled polyester used in Nike products begins as recycled plastic bottles, which are cleaned, shredded into flakes and converted into pellets. From there, the pellets are spun into new, high-quality yarn used in our products, delivering peak performance with a lower impact on the environment. ","type":"text"}],"type":"list_item"},{"content":[{"text":"In addition to reducing waste, recycled polyester produces up to 30% lower carbon emissions than virgin polyester. Nike diverts an average of 1 billion plastic bottles annually from landfill and waterways.","type":"text"}],"type":"list_item"}],"type":"bullet_list"}]},"body":"\u003cul\u003e\n  \u003cli\u003eThe recycled polyester used in Nike products begins as recycled plastic bottles, which are cleaned, shredded into flakes and converted into pellets. From there, the pellets are spun into new, high-quality yarn used in our products, delivering peak performance with a lower impact on the environment. \u003c/li\u003e\n  \u003cli\u003eIn addition to reducing waste, recycled polyester produces up to 30% lower carbon emissions than virgin polyester. Nike diverts an average of 1 billion plastic bottles annually from landfill and waterways.\u003c/li\u003e\n\u003c/ul\u003e"},{"jsonBody":{"type":"doc","content":[{"content":[{"content":[{"text":"Learn more about our ","type":"text"},{"text":"Move to Zero","marks":[{"attrs":{"href":"https://www.nike.com/sustainability","title":"https://www.nike.com/sustainability","target":"_blank"},"type":"link"},{"type":"underline"}],"type":"text"},{"text":" journey towards zero carbon and zero waste, including how we're working to design product with sustainability in mind and help protect the","type":"text"},{"text":" ","marks":[{"type":"strong"}],"type":"text"},{"text":"future of","type":"text"},{"text":" ","marks":[{"type":"strong"}],"type":"text"},{"text":"where we live and play.","type":"text"}],"type":"list_item"}],"type":"bullet_list"}]},"body":"\u003cul\u003e\n  \u003cli\u003eLearn more about our \u003ca href=\"https://www.nike.com/sustainability\" target=\"_blank\" title=\"https://www.nike.com/sustainability\"\u003e\u003cu\u003eMove to Zero\u003c/u\u003e\u003c/a\u003e journey towards zero carbon and zero waste, including how we're working to design product with sustainability in mind and help protect the\u003cstrong\u003e \u003c/strong\u003efuture of\u003cstrong\u003e \u003c/strong\u003ewhere we live and play.\u003c/li\u003e\n\u003c/ul\u003e"}]},"productType":"APPAREL","selectedSku":"","sizes":[{"label":"S","localizedLabel":"S","gtins":[{"gtin":"00196608715474"}],"sortSequence":14,"status":"ACTIVE","merchSkuId":"bf7e46a7-7db0-5d71-9e24-21da55eee534"},{"label":"M","localizedLabel":"M","gtins":[{"gtin":"00196608715481"}],"sortSequence":17,"status":"ACTIVE","merchSkuId":"6a0c8947-4595-5cdf-95e4-04865c963e31"},{"label":"L","localizedLabel":"L","gtins":[{"gtin":"00196608715498"}],"sortSequence":21,"status":"ACTIVE","merchSkuId":"f96eaa6a-bf11-5e47-96e5-c4dce726794e"},{"label":"XL","localizedLabel":"XL","gtins":[{"gtin":"00196608715504"}],"sortSequence":25,"status":"ACTIVE","merchSkuId":"e31b83bb-63e6-507a-9fe3-46692201e672"},{"label":"2XL","localizedLabel":"XXL","gtins":[{"gtin":"00196608715511"}],"sortSequence":29,"status":"ACTIVE","merchSkuId":"bec8e86c-3297-5a21-bbdd-827d98583790"}],"sizeSelectError":false,"sizeChartUrl":"https://www.nike.com/gb/size-fit/mens-tops-alpha","showAvailabilityDate":false,"statusModifier":"BUYABLE_BUY","sustainabilityDisclaimerMessage":"\u003cp\u003eThis product is made from 100% recycled polyester fibres\u003c/p\u003e","localizedLabelPrefix":"","giftCardMessageValueAddedServiceId":null,"unlock":null},"FB7482-010":{"ana